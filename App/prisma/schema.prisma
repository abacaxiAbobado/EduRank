datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  passwordHash          String
  salt                  String
  role                  String                @default("USER") // USER | ADMIN
  points                Int                   @default(0)
  avatar                String?               // Supported base64 images
  completedQuizzesCount Int                   @default(0)
  isSuspended           Boolean               @default(false)
  suspensionReason      String?
  suspensionEndsAt      DateTime?
  quizzesCreated        Quiz[]                @relation("QuizAuthor")
  submissions           QuizSubmission[]
  correctQuestions      UserCorrectQuestion[]
  contentsCreated       EducationalContent[]  @relation("ContentAuthor")
  logs                  AdminLog[]
}

model Quiz {
  id          String           @id @default(uuid())
  title       String
  description String
  category    String
  imageUrl    String?
  authorId    String
  author      User             @relation("QuizAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  questions   Question[]
  submissions QuizSubmission[]
}

model Question {
  id                 String                @id @default(uuid())
  questionText       String
  options            String[]              // PostgreSQL string array
  correctAnswerIndex Int
  explanation        String?
  quizId             String
  quiz               Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  correctAnswers     UserCorrectQuestion[]
}

model QuizSubmission {
  id           String   @id @default(uuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      Int[]    // PostgreSQL int array for responses
  score        Float
  pointsEarned Int
  createdAt    DateTime @default(now())
}

model UserCorrectQuestion {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredAt DateTime @default(now())

  @@unique([userId, questionId])
}

model EducationalContent {
  id            String   @id @default(uuid())
  title         String
  content       String
  category      String
  tags          String[] // PostgreSQL string array
  authorId      String
  author        User     @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  imageUrl      String?
  attachedFiles Json     @default("[]") // Json array of objects { name: string, url: string }
  createdAt     DateTime @default(now())
}

model AdminLog {
  id         String   @id @default(uuid())
  action     String
  details    String
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail String
  timestamp  DateTime @default(now())
}
